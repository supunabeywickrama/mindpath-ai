APP_NAME=MindPath API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENV=dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mindpath
OPENAI_API_KEY=sk-proj-.....
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

AUTH_MODE=local
SECRET_KEY=dev_secret_key_change_in_prod
ALGORITHM=HS256
ASGARDEO_ISSUER=https://api.asgardeo.io/t/org_name/oauth2/token
ASGARDEO_AUDIENCE=client_id

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=no-reply@mindpath.ai
